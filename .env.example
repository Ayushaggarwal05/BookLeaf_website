# Application Environment
ENVIRONMENT=development
APP_NAME="BookLeaf Author Support & Communication Portal"
DEBUG=true

# Database Configuration
# Local Development default: SQLite
DATABASE_URL=sqlite:///./bookleaf_dev.db
# Production example:
# DATABASE_URL=postgresql://bookleaf_user:bookleaf_password@localhost:5432/bookleaf_db

# CORS / Frontend origin & API Base URL
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Demo Credentials for Development & Testing Environments Only
DEMO_ADMIN_EMAIL=admin@bookleaf.in
DEMO_ADMIN_PASSWORD=Admin@BookLeaf2026!
DEMO_AUTHOR_PASSWORD=Author@BookLeaf2026!

# AI Integration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Sample Data File Path
SAMPLE_DATA_PATH=data/bookleaf_sample_data.json

